local function toggleFarm()
	farming = not farming
	if farming then
		farmBtn.Text = "FARM: ON"
		farmBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		blacklisted = {}
		task.spawn(farmLoop)
	else
		farmBtn.Text = "FARM: OFF"
		farmBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 0)
		if currentPrompt then
			pcall(function() currentPrompt:InputHoldEnd() end)
			currentPrompt = nil
		end
		status.Text = "FARM STOPPED"
		status.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	end
end

