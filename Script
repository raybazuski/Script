----------------------------------------------------------------
-- helpers
----------------------------------------------------------------
local farming = false
local currentPrompt = nil
local blacklisted = {}
local MAX_DIST = 2000
local MAX_TRIES = 10

local remotes = ReplicatedStorage:FindFirstChild("remotes")
local stompR = remotes and remotes:FindFirstChild("stomp")
local pickupR = remotes and remotes:FindFirstChild("pickup")
local grabR = remotes and remotes:FindFirstChild("grab")

local function getScoreObj()
	local s = player:FindFirstChild("stats")
	return s and s:FindFirstChild("Score")
end

local scoreConn
local function bindScore()
	local s = getScoreObj()
	if not s then return end
	scoreLbl.Text = "Score: " .. tostring(s.Value)
	if scoreConn then scoreConn:Disconnect() end
	scoreConn = s:GetPropertyChangedSignal("Value"):Connect(function()
		scoreLbl.Text = "Score: " .. tostring(s.Value)
	end)
end

local function getScore()
	local s = getScoreObj()
	return s and s.Value or 0
end

local function getHRP()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function waitHRP()
	while farming do
		local h = getHRP()
		if h then return h end
		task.wait(0.4)
	end
end

local function fireRemotes(prompt)
	local function fire(r, ...)
		if r and r:IsA("RemoteEvent") then
			pcall(function() r:FireServer(...) end)
		end
	end
	fire(stompR, prompt)
	fire(pickupR, prompt)
	fire(grabR, prompt)
	fire(stompR)
	fire(pickupR)
	if prompt and prompt.Parent then
		fire(stompR, prompt.Parent)
		fire(pickupR, prompt.Parent)
	end
end

-- ONLY money crates
local function isMoney(prompt)
	if not prompt:IsA("ProximityPrompt") then return false end
	if not prompt.Enabled or not prompt.Parent then return false end
	if blacklisted[prompt] then return false end
	local act = string.lower(tostring(prompt.ActionText or ""))
	local obj = tostring(prompt.ObjectText or "")
	if act == "buy" and obj:find("%$") then return true end
	if obj:match("^%$%d+") then return true end
	return false
end

local function getCrates()
	local list, seen = {}, {}
	local hrp = getHRP()
	local pos = hrp and hrp.Position or Vector3.zero

	local function add(p)
		if isMoney(p) and not seen[p] then
			local part = p.Parent
			if not part:IsA("BasePart") then
				part = part:FindFirstChildWhichIsA("BasePart", true)
			end
			if part then
				local d = (part.Position - pos).Magnitude
				if d <= MAX_DIST then
					seen[p] = true
					table.insert(list, {prompt = p, part = part, dist = d})
				end
			end
		end
	end

	for _, p in ipairs(CollectionService:GetTagged("crate_prompt")) do add(p) end
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("ProximityPrompt") then add(p) end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function tp(part)
	local hrp = getHRP()
	if not hrp or not part then return false end
	local target = part.Position + Vector3.new(0, 3.2, 0)
	for i = 1, 12 do
		if not farming then return false end
		hrp.CFrame = CFrame.new(target)
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.025)
	end
	return true
end

local function collect(prompt, part)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end
	currentPrompt = prompt
	local start = getScore()
	local hold = math.max(prompt.HoldDuration or 1, 1)

	fireRemotes(prompt)
	pcall(function() prompt:InputHoldBegin() end)
	pcall(function() if fireproximityprompt then fireproximityprompt(prompt) end end)

	local endt = tick() + hold + 2.5
	while tick() < endt and farming do
		if not getHRP() then
			waitHRP()
			if not farming then break end
		end
		tp(part)
		fireRemotes(prompt)
		if not prompt.Parent or not prompt.Enabled then break end
		if getScore() > start then break end
		task.wait(0.1)
	end
	pcall(function() prompt:InputHoldEnd() end)
	currentPrompt = nil
	task.wait(0.4)
	return getScore() > start or not prompt.Parent or not prompt.Enabled
end

----------------------------------------------------------------
-- loop
----------------------------------------------------------------
local function farmLoop()
	status.Text = "FARM RUNNING..."
	status.BackgroundColor3 = Color3.fromRGB(0, 160, 0)

	while farming do
		if not getHRP() then
			status.Text = "WAITING RESPAWN..."
			waitHRP()
			if not farming then break end
			task.wait(0.6)
		end

		local crates = getCrates()
		status.Text = "FOUND " .. #crates .. " MONEY CRATES"

		if #crates == 0 then
			task.wait(1.5)
		else
			for _, e in ipairs(crates) do
				if not farming then break end
				if not getHRP() then
					waitHRP()
					if not farming then break end
				end

				local prompt, part = e.prompt, e.part
				if prompt.Parent and prompt.Enabled and not blacklisted[prompt] then
					status.Text = "GOING → " .. tostring(prompt.ObjectText)

					local ok, tries = false, 0
					while farming and not ok and tries < MAX_TRIES do
						tries = tries + 1
						if not getHRP() then
							waitHRP()
							if not farming then break end
						end
						if tp(part) then
							task.wait(0.12)
							ok = collect(prompt, part)
						end
						if not (prompt.Parent and prompt.Enabled) then ok = true end
						if not ok then task.wait(0.25) end
					end

					if ok then
						status.Text = "COLLECTED " .. tostring(prompt.ObjectText)
					else
						blacklisted[prompt] = true
						status.Text = "FAILED - SKIPPED"
					end
				end
			end
		end
		task.wait(0.4)
	end

	status.Text = "FARM STOPPED"
	status.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
end

