local farmingThread = nil
local watchdogThread = nil

local function getScore()
    local s = plr:FindFirstChild("stats")
    if s then
        local score = s:FindFirstChild("Score")
        if score then
            return score.Value
        end
    end
    return 0
end

local function updateScore()
    local s = plr:FindFirstChild("stats")
    if s then
        local score = s:FindFirstChild("Score")
        if score then
            scoreLabel.Text = "SCORE: " .. tostring(score.Value)
            return
        end
    end
    scoreLabel.Text = "SCORE: 0"
end

local function setupScoreListener()
    local s = plr:FindFirstChild("stats")
    if s then
        local score = s:FindFirstChild("Score")
        if score then
            score.Changed:Connect(function()
                updateScore()
            end)
        end
    end
end
setupScoreListener()

game:GetService("RunService").Heartbeat:Connect(function()
    if tick() - lastScoreUpdate > SCORE_UPDATE_INTERVAL then
        updateScore()
        lastScoreUpdate = tick()
    end
end)

local function toggleScreensaver()
    screensaverOn = not screensaverOn
    blackBg.Visible = screensaverOn
    ssBtn.Text = "SS: " .. (screensaverOn and "ON" or "OFF")
    st.Text = string.gsub(st.Text, "SS: %w+", "SS: " .. (screensaverOn and "ON" or "OFF"))
end

local function setNoclip(state)
    if not USE_NOCLIP then return end
    local char = plr.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

local function startHover(targetPos)
    if hoverThread then
        task.cancel(hoverThread)
        hoverThread = nil
    end
    hoverThread = task.spawn(function()
        while on and hoverThread do
            local h = getHRP()
            if h then
                h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
            end
            task.wait(HOVER_UPDATE_INTERVAL)
        end
    end)
end

local function stopHover()
    if hoverThread then
        task.cancel(hoverThread)
        hoverThread = nil
    end
end

local function getHRP()
    local c = plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local c = plr.Character
    local hum = c and c:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end

local function getCrates()
    local list = {}
    local folder = Workspace:FindFirstChild(LOOT_FOLDER)
    if not folder then return list end

    for _, model in ipairs(folder:GetChildren()) do
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt")
        if not prompt then
            prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        end

        local part = model:FindFirstChild("main")
        if not part or not part:IsA("BasePart") then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("BasePart") then
                    part = child
                    break
                end
            end
        end

        if prompt and part and prompt.Enabled then
            local key = tostring(model)
            if not collectedCache[key] then
                table.insert(list, {
                    prompt = prompt,
                    part = part,
                    key = key,
                    name = model.Name
                })
            end
        end
    end
    return list
end

local function teleportToPart(part)
    local h = getHRP()
    if not h or not part or not isAlive() then return false end
    local targetPos = part.Position + TP_OFFSET

    if (h.Position - targetPos).Magnitude < 3 then
        h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
        return true
    end

    h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
    task.wait(TELEPORT_DELAY)
    return true
end

local function collectItem(prompt)
    if not prompt or not prompt.Parent then return false end
    local original = prompt.HoldDuration
    prompt.HoldDuration = 0
    local success = pcall(function()
        fireproximityprompt(prompt)
    end)
    return success
end

local function farmingLoop()
    while on do
        local ok, err = pcall(function()
            while on and not isAlive() do
                if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                    st.Text = "WAITING RESPAWN... | SS: " .. (screensaverOn and "ON" or "OFF")
                    lastGuiUpdate = tick()
                end
                task.wait(0.5)
            end
            if not on then return end

            if not Workspace:FindFirstChild(LOOT_FOLDER) then
                st.Text = "FOLDER MISSING - RETRYING... | SS: " .. (screensaverOn and "ON" or "OFF")
                task.wait(2)
                return
            end

            local crates = getCrates()
            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                st.Text = "CRATES: " .. #crates .. " | Collected: " .. totalCollected .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                lastGuiUpdate = tick()
            end

            if #crates == 0 then
                if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                    st.Text = "NO CRATES - RESETTING | SS: " .. (screensaverOn and "ON" or "OFF")
                    lastGuiUpdate = tick()
                end
                task.wait(1.5)
                if #collectedCache > 0 then
                    collectedCache = {}
                end
            else
                for _, crate in ipairs(crates) do
                    if not on then break end
                    if not isAlive() then break end

                    if collectedCache[crate.key] then
                        if crate.prompt.Parent and crate.prompt.Enabled then
                            collectedCache[crate.key] = nil
                        else
                            continue
                        end
                    end

                    if not crate.prompt.Parent or not crate.prompt.Enabled then
                        collectedCache[crate.key] = true
                        continue
                    end

                    local startScore = getScore()
                    local startTime = tick()
                    local collected = false

                    while on and (tick() - startTime) < MAX_COLLECT_TIME do
                        if not crate.prompt.Parent or not crate.prompt.Enabled then
                            collected = true
                            break
                        end

                        if getScore() > startScore then
                            collected = true
                            totalCollected = totalCollected + 1
                            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                                st.Text = "COLLECTED (" .. totalCollected .. "): " .. crate.name .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                                lastGuiUpdate = tick()
                            end
                            collectedCache[crate.key] = true
                            break
                        end

                        if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                            st.Text = "TP → " .. crate.name .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                            lastGuiUpdate = tick()
                        end

                        if teleportToPart(crate.part) then
                            local targetPos = crate.part.Position + TP_OFFSET
                            startHover(targetPos)

                            task.wait(EXTRA_WAIT_AFTER_TP + math.random() * 0.05)

                            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                                st.Text = "COLLECTING " .. crate.name .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                                lastGuiUpdate = tick()
                            end

                            collectItem(crate.prompt)

                            if getScore() > startScore then
                                collected = true
                                totalCollected = totalCollected + 1
                                if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                                    st.Text = "COLLECTED (" .. totalCollected .. "): " .. crate.name .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                                    lastGuiUpdate = tick()
                                end
                                collectedCache[crate.key] = true
                                stopHover()
                                break
                            end

                            stopHover()
                        else
                            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                                st.Text = "TP FAILED | SS: " .. (screensaverOn and "ON" or "OFF")
                                lastGuiUpdate = tick()
                            end
                        end

                        task.wait(0.2)
                    end

                    if not collected then
                        if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                            st.Text = "TIMEOUT: " .. crate.name .. " | SS: " .. (screensaverOn and "ON" or "OFF")
                            lastGuiUpdate = tick()
                        end
                        collectedCache[crate.key] = true
                    end

                    stopHover()
                    task.wait(0.2)
                end
            end
            task.wait(0.3)
        end)

        if not ok then
            st.Text = "ERROR: " .. tostring(err) .. " - RESTARTING..."
            print("FARM ERROR:", err)
            task.wait(2)
            collectedCache = {}
        end
    end

    setNoclip(false)
    stopHover()
    st.Text = "STOPPED | SS: " .. (screensaverOn and "ON" or "OFF")
end

local function watchdog()
    while true do
        if on then
            if not farmingThread or task.status(farmingThread) == "dead" then
                st.Text = "RESTARTING FARM... | SS: " .. (screensaverOn and "ON" or "OFF")
                task.wait(1)
                farmingThread = task.spawn(farmingLoop)
            end
        end
        task.wait(2)
    end
end

watchdogThread = task.spawn(watchdog)

local function toggle()
    on = not on
    if on then
        fb.Text = "FARM: ON"
        fb.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        collectedCache = {}
        totalCollected = 0
        st.Text = "STARTING... | SS: " .. (screensaverOn and "ON" or "OFF")
        updateScore()
        setNoclip(true)
        if not farmingThread or task.status(farmingThread) == "dead" then
            farmingThread = task.spawn(farmingLoop)
        end
    else
        fb.Text = "FARM: OFF"
        fb.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        st.Text = "STOPPED | SS: " .. (screensaverOn and "ON" or "OFF")
        setNoclip(false)
        stopHover()
        if farmingThread then
            task.cancel(farmingThread)
            farmingThread = nil
        end
    end
end

fb.MouseButton1Click:Connect(toggle)
ssBtn.MouseButton1Click:Connect(toggleScreensaver)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then toggle() end
    if input.KeyCode == Enum.KeyCode.S then toggleScreensaver() end
end)

