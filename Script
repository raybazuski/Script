local on = false
local collectedCache = {}
local totalCollected = 0
local hoverThread = nil
local lastGuiUpdate = 0
local lastScoreUpdate = 0

-- Score update function
local function updateScore()
    local s = plr:FindFirstChild("stats")
    if s then
        local score = s:FindFirstChild("Score")
        if score then
            scoreLabel.Text = "SCORE: " .. tostring(score.Value)
            return
        end
    end
    scoreLabel.Text = "SCORE: 0"
end

-- Listen for score changes
local function setupScoreListener()
    local s = plr:FindFirstChild("stats")
    if s then
        local score = s:FindFirstChild("Score")
        if score then
            score.Changed:Connect(function()
                updateScore()
            end)
        end
    end
end
setupScoreListener()

-- Also update periodically (fallback)
game:GetService("RunService").Heartbeat:Connect(function()
    if tick() - lastScoreUpdate > SCORE_UPDATE_INTERVAL then
        updateScore()
        lastScoreUpdate = tick()
    end
end)

-- Noclip
local function setNoclip(state)
    if not USE_NOCLIP then return end
    local char = plr.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- Hover
local function startHover(targetPos)
    if hoverThread then
        task.cancel(hoverThread)
        hoverThread = nil
    end
    hoverThread = task.spawn(function()
        while on and hoverThread do
            local h = getHRP()
            if h then
                h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
            end
            task.wait(HOVER_UPDATE_INTERVAL)
        end
    end)
end

local function stopHover()
    if hoverThread then
        task.cancel(hoverThread)
        hoverThread = nil
    end
end

local function getHRP()
    local c = plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local c = plr.Character
    local hum = c and c:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end

local function getCrates()
    local list = {}
    local folder = Workspace:FindFirstChild(LOOT_FOLDER)
    if not folder then return list end

    for _, model in ipairs(folder:GetChildren()) do
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt")
        if not prompt then
            prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        end

        local part = model:FindFirstChild("main")
        if not part or not part:IsA("BasePart") then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("BasePart") then
                    part = child
                    break
                end
            end
        end

        if prompt and part and prompt.Enabled then
            local key = tostring(model)
            if not collectedCache[key] then
                table.insert(list, {
                    prompt = prompt,
                    part = part,
                    key = key,
                    name = model.Name
                })
            end
        end
    end
    return list
end

local function teleportToPart(part)
    local h = getHRP()
    if not h or not part or not isAlive() then return false end
    local targetPos = part.Position + TP_OFFSET

    if (h.Position - targetPos).Magnitude < 3 then
        h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
        return true
    end

    h.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, -1, 0))
    task.wait(TELEPORT_DELAY)
    return true
end

local function collectItem(prompt)
    if not prompt or not prompt.Parent then return false end
    local original = prompt.HoldDuration
    prompt.HoldDuration = 0
    local success = pcall(function()
        fireproximityprompt(prompt)
    end)
    return success
end

local function farmingLoop()
    setNoclip(true)

    while on do
        while on and not isAlive() do
            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                st.Text = "WAITING RESPAWN..."
                lastGuiUpdate = tick()
            end
            task.wait(0.5)
        end
        if not on then break end

        local crates = getCrates()
        if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
            st.Text = "CRATES: " .. #crates .. " | Collected: " .. totalCollected
            lastGuiUpdate = tick()
        end

        if #crates == 0 then
            if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                st.Text = "NO CRATES - RESETTING"
                lastGuiUpdate = tick()
            end
            task.wait(1.5)
            if #collectedCache > 0 then
                collectedCache = {}
            end
        else
            for _, crate in ipairs(crates) do
                if not on then break end
                if not isAlive() then break end

                if collectedCache[crate.key] then
                    if crate.prompt.Parent and crate.prompt.Enabled then
                        collectedCache[crate.key] = nil
                    else
                        continue
                    end
                end

                if not crate.prompt.Parent or not crate.prompt.Enabled then
                    collectedCache[crate.key] = true
                    continue
                end

                if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                    st.Text = "TP → " .. crate.name
                    lastGuiUpdate = tick()
                end

                if teleportToPart(crate.part) then
                    local targetPos = crate.part.Position + TP_OFFSET
                    startHover(targetPos)

                    task.wait(EXTRA_WAIT_AFTER_TP + math.random() * 0.05)

                    if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                        st.Text = "COLLECTING " .. crate.name
                        lastGuiUpdate = tick()
                    end

                    local success = collectItem(crate.prompt)
                    if success then
                        totalCollected = totalCollected + 1
                        if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                            st.Text = "COLLECTED (" .. totalCollected .. "): " .. crate.name
                            lastGuiUpdate = tick()
                        end
                        collectedCache[crate.key] = true
                    else
                        if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                            st.Text = "FAILED: " .. crate.name
                            lastGuiUpdate = tick()
                        end
                    end

                    stopHover()
                    task.wait(0.2)
                else
                    if tick() - lastGuiUpdate > GUI_UPDATE_INTERVAL then
                        st.Text = "TP FAILED"
                        lastGuiUpdate = tick()
                    end
                    task.wait(0.5)
                end
            end
        end
        task.wait(0.3)
    end

    setNoclip(false)
    stopHover()
    st.Text = "STOPPED"
end

local function toggle()
    on = not on
    if on then
        fb.Text = "FARM: ON"
        fb.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        collectedCache = {}
        totalCollected = 0
        st.Text = "STARTING..."
        updateScore()   -- immediate update
        task.spawn(farmingLoop)
    else
        fb.Text = "FARM: OFF"
        fb.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        st.Text = "STOPPED"
        stopHover()
    end
end

fb.MouseButton1Click:Connect(toggle)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then toggle() end
end)

